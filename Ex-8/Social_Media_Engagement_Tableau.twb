<?xml version="1.0" encoding="utf-8" ?>
<workbook version="18.1" source-build="2026.2.2" source-platform="win" original-version="18.1" xmlns:user="http://www.tableausoftware.com/xml/user">
  <preferences>
    <preference name="ui.encoding.shelf.height" value="24" />
    <preference name="ui.shelf.height" value="26" />
  </preferences>
  <datasources>
    <datasource caption="Social_Media_Engagement_Clean" inline="true" name="federated.socialmedia" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="Social_Media_Engagement_Clean" name="textscan.socialmedia">
            <connection class="textscan" directory="/content" filename="Social_Media_Engagement_Clean.csv" password="" server="" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.socialmedia" name="Social_Media_Engagement_Clean.csv" table="[Social_Media_Engagement_Clean#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_IN" separator=",">
            <column datatype="integer" name="post_id" ordinal="0" />
            <column datatype="date" name="post_date" ordinal="1" />
            <column datatype="integer" name="user_id" ordinal="2" />
            <column datatype="string" name="platform" ordinal="3" />
            <column datatype="string" name="content_type" ordinal="4" />
            <column datatype="string" name="category" ordinal="5" />
            <column datatype="integer" name="followers" ordinal="6" />
            <column datatype="integer" name="impressions" ordinal="7" />
            <column datatype="integer" name="likes" ordinal="8" />
            <column datatype="integer" name="comments" ordinal="9" />
            <column datatype="integer" name="shares" ordinal="10" />
            <column datatype="real" name="engagement_rate" ordinal="11" />
            <column datatype="string" name="sentiment" ordinal="12" />
            <column datatype="integer" name="year" ordinal="13" />
            <column datatype="integer" name="month" ordinal="14" />
            <column datatype="string" name="month_name" ordinal="15" />
            <column datatype="string" name="year_month" ordinal="16" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Platform Engagement">
      <repository-location derived-from="file://Platform Engagement" id="Platform Engagement" path="/workbooks" revision="1.0" />
      <layout-options>
        <title><formatted-text><run>Platform-wise Engagement</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption="Social_Media_Engagement_Clean" name="federated.socialmedia" /></datasources>
          <datasource-dependencies datasource="federated.socialmedia">
            <column-instance column="[platform]" derivation="None" name="[none:platform:nk]" pivot="key" type="nominal" />
            <column-instance column="[likes]" derivation="Sum" name="[sum:likes:qk]" pivot="key" type="quantitative" />
            <column-instance column="[comments]" derivation="Sum" name="[sum:comments:qk]" pivot="key" type="quantitative" />
            <column-instance column="[shares]" derivation="Sum" name="[sum:shares:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <rows>[federated.socialmedia].[none:platform:nk]</rows>
          <cols>[federated.socialmedia].[sum:likes:qk]</cols>
        </view>
        <style />
        <panes><pane><view><breakdown value="auto" /></view><mark class="Automatic" /></pane></panes>
      </table>
    </worksheet>
    <worksheet name="Content Engagement">
      <repository-location derived-from="file://Content Engagement" id="Content Engagement" path="/workbooks" revision="1.0" />
      <layout-options><title><formatted-text><run>Engagement by Content Type</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption="Social_Media_Engagement_Clean" name="federated.socialmedia" /></datasources>
          <datasource-dependencies datasource="federated.socialmedia">
            <column-instance column="[content_type]" derivation="None" name="[none:content_type:nk]" pivot="key" type="nominal" />
            <column-instance column="[engagement_rate]" derivation="Average" name="[avg:engagement_rate:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <rows>[federated.socialmedia].[none:content_type:nk]</rows>
          <cols>[federated.socialmedia].[avg:engagement_rate:qk]</cols>
        </view>
        <style />
        <panes><pane><view><breakdown value="auto" /></view><mark class="Automatic" /></pane></panes>
      </table>
    </worksheet>
    <worksheet name="Platform Contribution">
      <repository-location derived-from="file://Platform Contribution" id="Platform Contribution" path="/workbooks" revision="1.0" />
      <layout-options><title><formatted-text><run>Engagement Contribution by Platform</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption="Social_Media_Engagement_Clean" name="federated.socialmedia" /></datasources>
          <datasource-dependencies datasource="federated.socialmedia">
            <column-instance column="[platform]" derivation="None" name="[none:platform:nk]" pivot="key" type="nominal" />
            <column-instance column="[likes]" derivation="Sum" name="[sum:likes:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <rows>[federated.socialmedia].[sum:likes:qk]</rows>
          <cols>[federated.socialmedia].[none:platform:nk]</cols>
        </view>
        <style />
        <panes><pane><view><breakdown value="auto" /></view><mark class="Automatic" /></pane></panes>
      </table>
    </worksheet>
    <worksheet name="Monthly Engagement Trend">
      <repository-location derived-from="file://Monthly Engagement Trend" id="Monthly Engagement Trend" path="/workbooks" revision="1.0" />
      <layout-options><title><formatted-text><run>Monthly Social Media Engagement Trend</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption="Social_Media_Engagement_Clean" name="federated.socialmedia" /></datasources>
          <datasource-dependencies datasource="federated.socialmedia">
            <column-instance column="[year_month]" derivation="None" name="[none:year_month:nk]" pivot="key" type="nominal" />
            <column-instance column="[likes]" derivation="Sum" name="[sum:likes:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <rows>[federated.socialmedia].[sum:likes:qk]</rows>
          <cols>[federated.socialmedia].[none:year_month:nk]</cols>
        </view>
        <style />
        <panes><pane><view><breakdown value="auto" /></view><mark class="Automatic" /></pane></panes>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard enable-sort-zone-taborder="true" name="Social Media Engagement Dashboard">
      <layout-options><title><formatted-text><run>Social Media Engagement Analysis</run></formatted-text></title></layout-options>
      <zones>
        <zone h="30000" id="1" name="Platform Engagement" show-title="true" type-v2="worksheet" w="50000" x="0" y="0">
          <zone-style><format attr="border-color" value="#000000" /></zone-style>
        </zone>
        <zone h="30000" id="2" name="Content Engagement" show-title="true" type-v2="worksheet" w="50000" x="50000" y="0">
          <zone-style><format attr="border-color" value="#000000" /></zone-style>
        </zone>
        <zone h="30000" id="3" name="Platform Contribution" show-title="true" type-v2="worksheet" w="50000" x="0" y="30000">
          <zone-style><format attr="border-color" value="#000000" /></zone-style>
        </zone>
        <zone h="30000" id="4" name="Monthly Engagement Trend" show-title="true" type-v2="worksheet" w="50000" x="50000" y="30000">
          <zone-style><format attr="border-color" value="#000000" /></zone-style>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <storyboards />
</workbook>
